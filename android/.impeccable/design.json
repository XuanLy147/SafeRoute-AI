  "narrative": {
    "northStar": "Smart Mobility Blue",
    "overview": "Smart Mobility Blue is the supplied visual direction. The implementation uses native Material Components, clear Vietnamese labels, pale backgrounds and blue actions to make recorded road conditions and route choices legible. This document preserves that incumbent system; it does not introduce a new identity.\n\nThe screen hierarchy is practical and compact: a clear title, the relevant map or inputs, explicit status, then supporting details. Verification and selected-route state have both text and color cues. The documented system is extracted from source; device-level visual acceptance is still outstanding.",
    "keyCharacteristics": [
      "Native Java/XML Material controls.",
      "Blue actions, neutral surfaces and explicit semantic status.",
      "Scrollable phone layouts with persistent, labeled navigation.",
      "Flat outlined cards with visible selection."
    ],
    "rules": [
      {
        "name": "The Evidence Label Rule",
        "body": "Verification and route selection must remain understandable without color.",
        "section": "colors"
      },
      {
        "name": "The Flat Card Rule",
        "body": "Keep list-card hierarchy in content, spacing and stroke rather than added decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Android resource roles so light and dark schemes resolve together.",
      "Do keep status labels and route explanations alongside visual cues.",
      "Do preserve native sp text, touch targets and keyboard/system insets.",
      "Do keep all controls reachable when the screen is short or text is enlarged."
    ],
    "donts": [
      "Don't use a risk color or score to imply guaranteed safety.",
      "Don't fabricate route alternatives, geometry, scores or verification.",
      "Don't replace native controls with browser-rendered UI.",
      "Don't treat sidecar browser previews as Android screenshot evidence."
    ]
  }
}
