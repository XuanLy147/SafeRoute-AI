<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_screen" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tv2_community_feedback_2_contentdescription" android:src="@drawable/ic_back" android:minHeight="48dp" android:textAllCaps="false" app:tint="@color/primary" />
            <TextView android:id="@+id/tvReportTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:text="@string/tv2_report_wizard_4_text" android:textColor="@color/text_title" android:textSize="24sp" android:textStyle="bold" android:textAppearance="@style/Text.SafeRoute.Title" />
            <ImageButton android:id="@+id/btnOpenReports" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tv2_my_reports_3_text" android:src="@drawable/ic_history" android:minHeight="48dp" android:textAllCaps="false" app:tint="@color/primary" />
            <ImageButton android:id="@+id/btnOpenProfile" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tv2_my_reports_4_contentdescription" android:src="@drawable/ic_person" android:minHeight="48dp" android:textAllCaps="false" app:tint="@color/primary" />
            <ImageButton android:id="@+id/btnOpenReview" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tv2_profile_20_text" android:src="@android:drawable/ic_menu_edit" android:visibility="gone" android:minHeight="48dp" android:textAllCaps="false" app:tint="@color/primary" />
        </LinearLayout>
        <FrameLayout android:id="@+id/containerImage" android:layout_width="match_parent" android:layout_height="220dp" android:background="@drawable/bg_edit_text">
            <LinearLayout android:id="@+id/layoutPlaceholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_camera" android:importantForAccessibility="no" app:tint="@color/primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/tv2_report_wizard_11_text" android:textColor="@color/text_body" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/tv2_report_wizard_12_text" android:textColor="@color/text_hint" android:textSize="14sp" />
            </LinearLayout>
            <ImageView android:id="@+id/imgPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/tv2_report_wizard_13_contentdescription" android:scaleType="fitCenter" android:visibility="gone" tools:visibility="visible" />
            <com.comeforfood.saferoute.feature.report.BoundingBoxOverlayView android:id="@+id/bboxOverlay" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPickGallery" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="@string/tv2_report_wizard_16_text" android:textAllCaps="false" android:textColor="@color/brand_primary" app:cornerRadius="12dp" app:strokeColor="@color/brand_primary" android:minHeight="48dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSimulateAi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:backgroundTint="@color/brand_primary" android:text="@string/analyze_image_action" android:textAllCaps="false" android:textColor="@color/white" app:cornerRadius="12dp" android:minHeight="48dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cardAiResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_edit_text" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
            <TextView android:id="@+id/tvAiTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_19_text" android:textColor="@color/brand_primary" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvAiDetectionSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ai_unavailable_detail" android:textColor="@color/text_title" android:textSize="14sp" />
            <TextView android:id="@+id/tvAiDisclaimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/tv2_report_wizard_21_text" android:textColor="@color/text_label" android:textSize="11.5sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/tv2_report_wizard_22_text" android:textColor="@color/text_label" android:textSize="14sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_edit_text" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_location" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tvCoordinates" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/report_location_missing" android:textColor="@color/text_body" android:textSize="14sp" />
            <TextView android:id="@+id/btnAdjustPin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/report_location_button" android:textColor="@color/brand_primary" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/tv2_report_wizard_27_text" android:textColor="@color/text_label" android:textSize="14sp" android:textStyle="bold" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipD40" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/tv2_report_wizard_29_text" />
            <com.google.android.material.chip.Chip android:id="@+id/chipD00" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_30_text" />
            <com.google.android.material.chip.Chip android:id="@+id/chipD10" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_31_text" />
            <com.google.android.material.chip.Chip android:id="@+id/chipD20" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_32_text" />
            <com.google.android.material.chip.Chip android:id="@+id/chipRepair" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_33_text" />
            <com.google.android.material.chip.Chip android:id="@+id/chipFlood" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_34_text" />
            <com.google.android.material.chip.Chip android:id="@+id/chipObstacle" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_35_text" />
        </com.google.android.material.chip.ChipGroup>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/tv2_report_wizard_36_text" android:textColor="@color/text_label" android:textSize="14sp" android:textStyle="bold" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupSeverity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipSevLow" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_38_text" />
            <com.google.android.material.chip.Chip android:id="@+id/chipSevMedium" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/tv2_report_wizard_39_text" />
            <com.google.android.material.chip.Chip android:id="@+id/chipSevHigh" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_report_wizard_40_text" />
        </com.google.android.material.chip.ChipGroup>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/tv2_report_wizard_41_text" android:textColor="@color/text_label" android:textSize="14sp" />
        <EditText android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="6dp" android:background="@drawable/bg_edit_text" android:gravity="top|start" android:hint="@string/tv2_report_wizard_42_hint" android:inputType="textMultiLine" android:padding="12dp" android:textColor="@color/text_title" android:textColorHint="@color/text_hint" android:textSize="13sp" android:importantForAutofill="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/tv2_report_wizard_43_text" android:textColor="@color/text_hint" android:textSize="11.5sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitReport" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:layout_marginBottom="24dp" android:backgroundTint="@color/brand_primary" android:text="@string/tv2_report_wizard_44_text" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" app:elevation="4dp" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>