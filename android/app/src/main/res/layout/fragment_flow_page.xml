<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<com.google.android.material.button.MaterialButton android:id="@+id/flowBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/flow_back" app:icon="@drawable/ic_back"/>
<TextView android:id="@+id/flowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/Text.SafeRoute.Title"/>
<TextView android:id="@+id/accessDeniedContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:visibility="gone" android:text="@string/role_denied" android:textAppearance="@style/Text.SafeRoute.Body"/>
<LinearLayout android:id="@+id/reviewerContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/flowBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:lineSpacingExtra="4dp" android:textAppearance="@style/Text.SafeRoute.Body" android:accessibilityLiveRegion="polite"/>
<LinearLayout android:id="@+id/flowActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"/>
</LinearLayout>
</LinearLayout></ScrollView>