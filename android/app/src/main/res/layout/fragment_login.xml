        </LinearLayout>
        <View android:id="@+id/dividerLeft" android:layout_width="0dp" android:layout_height="1dp" android:layout_marginEnd="12dp" android:background="@color/divider_color" app:layout_constraintBottom_toBottomOf="@+id/tvOrLogin" app:layout_constraintEnd_toStartOf="@+id/tvOrLogin" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@+id/tvOrLogin" />
