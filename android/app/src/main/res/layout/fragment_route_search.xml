<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_title"
            android:textAppearance="@style/Text.SafeRoute.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/route_subtitle"
            android:textAppearance="@style/Text.SafeRoute.Note" />

        <!-- Điểm xuất phát -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/origin_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:hintEnabled="false"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@color/input_surface"
                app:placeholderText="@string/address_hint"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/origin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/origin_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_gravity="top|start"
                android:background="@color/surface"
                android:paddingHorizontal="6dp"
                android:text="@string/origin"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:elevation="4dp" />
        </FrameLayout>

        <!-- Dropdown thả xuống của Điểm xuất phát -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/origin_dropdown_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:layout_marginHorizontal="2dp"
            android:visibility="visible"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            android:elevation="6dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/soft_line">

            <LinearLayout
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                                android:paddingVertical="13dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/primary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/origin_location_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/my_location"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_info_soft" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Điểm đến + Nút đổi vị trí A và B đơn giản bên phải -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="64dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/destination_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/input_surface"
                    app:placeholderText="@string/address_hint"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/destination_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_gravity="top|start"
                    android:background="@color/surface"
                    android:paddingHorizontal="6dp"
                    android:text="@string/destination"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:elevation="4dp" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/swap"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:minWidth="54dp"
                android:minHeight="54dp"
                android:padding="0dp"
                app:cornerRadius="27dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/soft_line"
                android:backgroundTint="@color/surface"
                android:elevation="2dp"
                app:elevation="2dp"
                app:icon="@drawable/ic_swap"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/primary"
                android:contentDescription="@string/swap"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Dropdown thả xuống của Điểm đến: dính sát rìa dưới của khung điểm đến -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/destination_dropdown_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:layout_marginEnd="64dp"
            android:layout_marginStart="2dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            android:elevation="6dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/soft_line">

            <LinearLayout
                android:id="@+id/destination_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="13dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/primary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/destination_location_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/my_location"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_info_soft" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- map_status ẩn đi theo yêu cầu "bỏ chạm bản đồ để đặt điểm A" -->
        <TextView
            android:id="@+id/map_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.comeforfood.saferoute.feature.shared.MapContainerFrameLayout
            android:id="@+id/map_container"
            android:background="@drawable/bg_soft_panel"
            android:clipToOutline="true"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.comeforfood.saferoute.feature.shared.MapContainerFrameLayout>

        <ProgressBar
            android:id="@+id/address_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/address_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.SafeRoute.Note"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compare"
            style="@style/Widget.SafeRoute.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="56dp"
            android:text="@string/compare"
            android:textAllCaps="false"
            android:letterSpacing="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/route_caution"
            android:textAppearance="@style/Text.SafeRoute.Note" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
