<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/route_title" android:textAppearance="@style/Text.SafeRoute.Title"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/route_subtitle" android:textAppearance="@style/Text.SafeRoute.Note"/>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/origin_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="@string/origin" app:placeholderText="@string/address_hint" app:boxCornerRadiusTopStart="24dp" app:boxCornerRadiusTopEnd="24dp" app:boxCornerRadiusBottomStart="24dp" app:boxCornerRadiusBottomEnd="24dp" app:boxBackgroundColor="@color/input_surface">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/origin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress" android:imeOptions="actionNext" android:maxLines="1" android:importantForAutofill="no"/>
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/destination_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/destination" app:placeholderText="@string/address_hint" app:boxCornerRadiusTopStart="24dp" app:boxCornerRadiusTopEnd="24dp" app:boxCornerRadiusBottomStart="24dp" app:boxCornerRadiusBottomEnd="24dp" app:boxBackgroundColor="@color/input_surface">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/destination" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress" android:imeOptions="actionDone" android:maxLines="1" android:importantForAutofill="no"/>
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/address_help" android:textAppearance="@style/Text.SafeRoute.Note"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
<com.google.android.material.button.MaterialButton android:textAllCaps="false" android:id="@+id/location" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/my_location" android:letterSpacing="0"/>
<com.google.android.material.button.MaterialButton android:textAllCaps="false" android:id="@+id/swap" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/swap" android:letterSpacing="0"/>
</LinearLayout>
<LinearLayout android:id="@+id/pick_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:textAllCaps="false" android:id="@+id/pick_a" style="@style/Widget.SafeRoute.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/choose_a" android:letterSpacing="0"/>
<com.google.android.material.button.MaterialButton android:textAllCaps="false" android:id="@+id/pick_b" style="@style/Widget.SafeRoute.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/choose_b" android:letterSpacing="0"/>
</LinearLayout>
<TextView android:id="@+id/map_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/bg_info_soft" android:textColor="@color/on_info" android:text="@string/map_unavailable_detail" android:textSize="14sp" android:accessibilityLiveRegion="polite"/>
<com.comeforfood.saferoute.feature.shared.MapContainerFrameLayout
    android:id="@+id/map_container"
    android:background="@drawable/bg_soft_panel"
    android:clipToOutline="true"
    android:layout_width="match_parent"
    android:layout_height="350dp"
    android:layout_marginTop="12dp"
    android:visibility="gone">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.comeforfood.saferoute.feature.shared.MapContainerFrameLayout>
<ProgressBar android:id="@+id/address_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone"/>
<TextView android:id="@+id/address_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.SafeRoute.Note" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:textAllCaps="false" android:id="@+id/compare" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="56dp" android:text="@string/compare" android:letterSpacing="0"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/route_caution" android:textAppearance="@style/Text.SafeRoute.Note"/>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
