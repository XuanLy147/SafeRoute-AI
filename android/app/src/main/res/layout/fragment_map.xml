<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="16dp">
<ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_saferoute_logo" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand_wordmark" android:textColor="@color/ink" android:textSize="20sp" android:fontFamily="sans-serif-black"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/polish_map_nearby" android:textAppearance="@style/Text.SafeRoute.Label"/>
</LinearLayout></LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/searchArea" style="@style/Widget.SafeRoute.Row" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flow_search_area" app:icon="@drawable/ic_search" app:iconGravity="start" app:iconTint="@color/primary" app:cornerRadius="28dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginVertical="4dp">
<com.google.android.material.button.MaterialButton android:id="@+id/openFilters" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAllCaps="false" android:letterSpacing="0" android:minHeight="48dp" android:text="@string/filter_label" android:textSize="13sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/openNearby" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAllCaps="false" android:letterSpacing="0" android:minHeight="48dp" android:text="@string/flow_nearby" android:textSize="13sp"/>
</LinearLayout>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="260dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/info" app:strokeWidth="0dp">
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
<androidx.fragment.app.FragmentContainerView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="match_parent"/>
<LinearLayout android:id="@+id/map_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp">
<ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_map" app:tint="@color/primary" android:importantForAccessibility="no"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/map_unavailable" android:textColor="@color/on_info" android:textSize="16sp" android:fontFamily="sans-serif-medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/map_unavailable_detail" android:gravity="center" android:textColor="@color/on_info" android:textSize="13sp"/>
</LinearLayout></FrameLayout></com.google.android.material.card.MaterialCardView>
<TextView android:id="@+id/map_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textAppearance="@style/Text.SafeRoute.Note" android:textSize="12sp" android:visibility="gone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
<com.google.android.material.button.MaterialButton android:id="@+id/location" style="@style/Widget.SafeRoute.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/my_location" app:icon="@drawable/ic_location" app:iconSize="18dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/routes" style="@style/Widget.SafeRoute.Primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/nav_routes" app:icon="@drawable/ic_route" app:iconSize="18dp"/>
</LinearLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none">
<com.google.android.material.chip.ChipGroup android:id="@+id/categories" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true">
<com.google.android.material.chip.Chip android:id="@+id/all" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/filter_all" app:ensureMinTouchTargetSize="true"/>
<com.google.android.material.chip.Chip android:id="@+id/pothole" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_pothole" app:ensureMinTouchTargetSize="true"/>
<com.google.android.material.chip.Chip android:id="@+id/cracks" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_cracks" app:ensureMinTouchTargetSize="true"/>
</com.google.android.material.chip.ChipGroup></HorizontalScrollView>
<com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/verified" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/filter_verified" android:textSize="14sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:background="@drawable/bg_soft_panel" android:gravity="center_vertical">
<TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="@style/Text.SafeRoute.Note" android:accessibilityLiveRegion="polite"/>
<com.google.android.material.button.MaterialButton android:id="@+id/refresh" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:letterSpacing="0" android:text="@string/refresh"/>
</LinearLayout>
<ProgressBar android:id="@+id/loading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone"/>
<LinearLayout android:id="@+id/report_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<LinearLayout android:id="@+id/report_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout></LinearLayout></androidx.core.widget.NestedScrollView>