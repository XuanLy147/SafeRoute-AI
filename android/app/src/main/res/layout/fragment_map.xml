<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. FULL-SCREEN BACKGROUND MAP LAYER -->
        <com.comeforfood.saferoute.feature.shared.MapContainerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/map_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@color/info">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_map"
                    app:tint="@color/primary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/map_unavailable"
                    android:textColor="@color/on_info"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/map_unavailable_detail"
                    android:gravity="center"
                    android:textColor="@color/on_info"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.comeforfood.saferoute.feature.shared.MapContainerFrameLayout>

        <!-- 2. FLOATING TOP CONTROLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:clipToPadding="false">

            <!-- Floating Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#F5FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="@color/soft_line">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <!-- Header Logo + Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_saferoute_logo"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/brand_wordmark"
                                android:textColor="@color/ink"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/polish_map_nearby"
                                android:textAppearance="@style/Text.SafeRoute.Label"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Search Area Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchArea"
                        style="@style/Widget.SafeRoute.Row"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:text="@string/flow_search_area"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_search"
                        app:iconGravity="start"
                        app:iconTint="@color/primary"
                        app:cornerRadius="22dp"
                        android:backgroundTint="@color/input_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Segmented Control Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#F5FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="@color/soft_line">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="2dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openFilters"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:text="@string/filter_label"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        app:cornerRadius="10dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:background="@color/soft_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openNearby"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:text="@string/flow_nearby"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Floating Category Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:clipToPadding="false">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/all"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/filter_all"
                        android:elevation="3dp"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/soft_line"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/pothole"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_pothole"
                        android:elevation="3dp"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/soft_line"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cracks"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_cracks"
                        android:elevation="3dp"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/soft_line"
                        app:ensureMinTouchTargetSize="true" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 3. FLOATING BOTTOM CONTROLS & ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false">

            <!-- Floating Status / Hazards Panel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#F7FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="@color/soft_line">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <!-- Status & Refresh Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.SafeRoute.Note"
                            android:textColor="@color/ink"
                            android:fontFamily="sans-serif-medium"
                            android:accessibilityLiveRegion="polite" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/refresh"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minHeight="36dp"
                            android:textAllCaps="false"
                            android:letterSpacing="0"
                            android:textSize="13sp"
                            android:text="@string/refresh" />
                    </LinearLayout>

                    <!-- Verified switch -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/verified"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:minHeight="36dp"
                        android:text="@string/filter_verified"
                        android:textSize="13sp" />

                    <!-- Loading bar -->
                    <ProgressBar
                        android:id="@+id/loading"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <!-- Hazards report list (collapsible/scrollable) -->
                    <LinearLayout
                        android:id="@+id/report_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <androidx.core.widget.NestedScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxHeight="160dp"
                            android:scrollbars="vertical">

                            <LinearLayout
                                android:id="@+id/report_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingTop="4dp" />
                        </androidx.core.widget.NestedScrollView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Map Status Label: "Bản đồ Google - Dữ liệu cảnh báo..." -->
            <TextView
                android:id="@+id/map_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_info_soft"
                android:textColor="@color/on_info"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/map_unavailable_detail"
                android:visibility="gone" />

            <!-- 2 Main Floating Action Buttons: My Location & Routes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/location"
                    style="@style/Widget.SafeRoute.Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:minHeight="52dp"
                    android:text="@string/my_location"
                    android:textSize="14sp"
                    android:textColor="@color/ink"
                    android:backgroundTint="#FFFFFF"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/soft_line"
                    app:cornerRadius="26dp"
                    app:elevation="4dp"
                    android:elevation="4dp"
                    app:icon="@drawable/ic_location"
                    app:iconSize="18dp"
                    app:iconTint="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/routes"
                    style="@style/Widget.SafeRoute.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:minHeight="52dp"
                    android:layout_marginStart="10dp"
                    android:text="@string/nav_routes"
                    android:textSize="14sp"
                    app:cornerRadius="26dp"
                    app:elevation="4dp"
                    android:elevation="4dp"
                    app:icon="@drawable/ic_route"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
