    "/api/v1/ai/detect": {
      "post": {
        "tags": [
          "AI Inference"
        ],
        "summary": "Phát hiện hư hỏng mặt đường bằng AI YOLOv12s",
        "description": "Nhận ảnh mặt đường và trả về danh sách các vùng phát hiện (D00, D10, D20, D40, Repair). Cho phép trả về detections=[] khi mặt đường bình thường.",
        "operationId": "detect_road_hazards_api_v1_ai_detect_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_detect_road_hazards_api_v1_ai_detect_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiDetectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiDetectResponse": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "description": "Phiên bản mô hình AI đã nạp",
            "default": "SafeRoute-YOLOv12s-v1.1"
          },
          "inference_time_ms": {
            "type": "number",
            "title": "Inference Time Ms",
            "description": "Thời gian suy luận (milliseconds)"
          },
          "device": {
            "type": "string",
            "title": "Device",
            "description": "Thiết bị chạy suy luận (cpu/cuda)",
            "default": "cpu"
          },
          "detections": {
            "items": {
              "$ref": "#/components/schemas/DetectionItem"
            },
            "type": "array",
            "title": "Detections",
            "description": "Danh sách các vùng hư hỏng phát hiện được. Cho phép rỗng [] nếu đường bình thường."
          }
        },
        "type": "object",
        "required": [
          "inference_time_ms"
        ],
        "title": "AiDetectResponse"
      },
      "Body_detect_road_hazards_api_v1_ai_detect_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Ảnh mặt đường cần nhận diện"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_detect_road_hazards_api_v1_ai_detect_post"
      },
      "Body_upload_image_api_v1_images_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "File ảnh bằng chứng"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_image_api_v1_images_post"
      },
      "DetectionItem": {
        "properties": {
          "class_code": {
            "type": "string",
            "title": "Class Code",
            "description": "Mã lớp hư hỏng: D00, D10, D20, D40, Repair"
          },
          "class_name": {
            "type": "string",
            "title": "Class Name",
            "description": "Tên loại hư hỏng tiếng Anh/Việt"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Độ tin cậy của mô hình YOLOv12s (0.0 - 1.0)"
          },
          "bbox": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bbox",
            "description": "Tọa độ Bounding Box [ymin, xmin, ymax, xmax] normalized hoặc pixel"
          }
        },
        "type": "object",
        "required": [
          "class_code",
          "class_name",
          "confidence",
          "bbox"
        ],
        "title": "DetectionItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageUploadResponse": {
        "properties": {
          "image_id": {
            "type": "string",
            "title": "Image Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "mime": {
            "type": "string",
            "title": "Mime"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "image_id",
          "filename",
          "mime",
          "size_bytes",
          "url"
        ],
        "title": "ImageUploadResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "title": "Password",
            "description": "Mật khẩu tối thiểu 6 ký tự"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PingResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "default": "SafeRoute AI API v1 ready"
          }
        },
        "type": "object",
        "title": "PingResponse"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "title": "Password",
            "description": "Mật khẩu tối thiểu 6 ký tự"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              },
              {
                "type": "null"
              }
            ],
            "default": "USER"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "ReportCreateRequest": {
        "properties": {
          "image_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id",
            "description": "UUID của ảnh đã tải lên qua POST /api/v1/images"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "description": "Vĩ độ (WGS84), ví dụ: 10.762622"
