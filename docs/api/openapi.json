        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Kiểm tra trạng thái hoạt động của hệ thống backend và cơ sở dữ liệu PostGIS.\nKhông làm sập app nếu DB tạm thời chưa sẵn sàng.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
