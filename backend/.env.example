# Copy only for local development; generate your own values, never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/saferoute
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
UPLOAD_DIR=uploads
ENABLE_DEMO_ACCOUNTS=false
PERSISTENT_UPLOADS=false
# GOOGLE_ROUTES_API_KEY must be provided explicitly; absence returns HTTP 502.
# RISK_POLICY_JSON must be an explicit approved or labeled demo profile.
