<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_screen" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="48dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/tv2_community_feedback_2_contentdescription" android:src="@drawable/ic_back" android:minHeight="48dp" android:textAllCaps="false" app:tint="@color/primary" />
        <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:text="@string/tv2_reviewer_3_text" android:textColor="@color/text_title" android:textSize="24sp" android:textStyle="bold" android:textAppearance="@style/Text.SafeRoute.Title" />
        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>
    <ScrollView android:id="@+id/reviewerContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/homeContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_badge_info" android:padding="10dp" android:text="@string/tv2_reviewer_8_text" android:textColor="@color/color_info" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/tv2_reviewer_9_text" android:textColor="@color/text_title" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/tv2_reviewer_10_text" android:textColor="@color/text_label" android:textSize="14sp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="12dp" app:strokeColor="@color/divider_color" app:strokeWidth="1dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_my_reports_12_text" android:textColor="@color/text_label" android:textSize="14sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_reviewer_14_text" android:textColor="@color/text_title" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_reviewer_15_text" android:textColor="@color/text_hint" android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenQueue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:backgroundTint="@color/brand_primary" android:text="@string/tv2_reviewer_16_text" android:textAllCaps="false" app:cornerRadius="12dp" android:minHeight="48dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenHistory" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/tv2_reviewer_17_text" android:textAllCaps="false" app:cornerRadius="12dp" android:minHeight="48dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/queueContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_badge_info" android:padding="10dp" android:text="@string/tv2_reviewer_19_text" android:textColor="@color/color_info" android:textSize="14sp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="12dp" app:strokeColor="@color/divider_color" app:strokeWidth="1dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_my_reports_36_text" android:textColor="@color/text_title" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_badge_pending" android:text="@string/tv2_my_reports_19_text" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnQueueItem" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/tv2_reviewer_24_text" android:textAllCaps="false" app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/detailContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_badge_info" android:padding="10dp" android:text="@string/tv2_reviewer_26_text" android:textColor="@color/color_info" android:textSize="14sp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/color_info_bg" app:cardCornerRadius="12dp" app:cardElevation="0dp">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/tv2_reviewer_28_text" android:textColor="@color/text_label" android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/tv2_reviewer_29_text" android:textColor="@color/text_body" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenDecision" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:backgroundTint="@color/brand_primary" android:text="@string/tv2_reviewer_30_text" android:textAllCaps="false" app:cornerRadius="12dp" android:minHeight="48dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/tv2_reviewer_31_text" android:textAllCaps="false" app:cornerRadius="12dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/decisionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_badge_info" android:padding="10dp" android:text="@string/tv2_reviewer_33_text" android:textColor="@color/color_info" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/tv2_reviewer_34_text" android:textColor="@color/text_body" android:textSize="14sp" />
                <EditText android:id="@+id/etRejectReason" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="14dp" android:background="@drawable/bg_edit_text" android:gravity="top|start" android:hint="@string/tv2_reviewer_35_hint" android:inputType="textMultiLine|textCapSentences" android:padding="12dp" android:textColor="@color/text_title" android:textColorHint="@color/text_hint" android:importantForAutofill="no" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnApprove" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:backgroundTint="@color/color_success" android:text="@string/tv2_reviewer_36_text" android:textAllCaps="false" app:cornerRadius="12dp" android:minHeight="48dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnReject" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:backgroundTint="@color/color_danger" android:text="@string/tv2_reviewer_37_text" android:textAllCaps="false" app:cornerRadius="12dp" android:minHeight="48dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDecisionBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/tv2_reviewer_38_text" android:textAllCaps="false" app:cornerRadius="12dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/historyContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_badge_info" android:padding="10dp" android:text="@string/tv2_reviewer_40_text" android:textColor="@color/color_info" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/tv2_reviewer_41_text" android:textColor="@color/text_label" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnHistoryBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv2_reviewer_42_text" android:textAllCaps="false" app:cornerRadius="12dp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/accessDeniedContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/tv2_reviewer_44_text" android:textColor="@color/text_body" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>