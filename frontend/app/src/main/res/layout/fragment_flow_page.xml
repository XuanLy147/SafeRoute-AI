<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<com.google.android.material.button.MaterialButton android:id="@+id/flowBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:minHeight="48dp" android:textAllCaps="false" android:letterSpacing="0" android:text="@string/flow_back" app:icon="@drawable/ic_back"/>
<ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_saferoute_logo" android:importantForAccessibility="no"/>
</LinearLayout>
<TextView android:id="@+id/flowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textAppearance="@style/Text.SafeRoute.Title"/>
<TextView android:id="@+id/accessDeniedContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="20dp" android:background="@drawable/bg_info_soft" android:visibility="gone" android:text="@string/role_denied" android:textAppearance="@style/Text.SafeRoute.Body"/>
<LinearLayout android:id="@+id/reviewerContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/flowBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="18dp" android:background="@drawable/bg_soft_panel" android:lineSpacingExtra="3dp" android:textAppearance="@style/Text.SafeRoute.Note" android:accessibilityLiveRegion="polite"/>
<LinearLayout android:id="@+id/flowActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical"/>
</LinearLayout></LinearLayout></ScrollView>